# Data source: public (no-key open feeds), supabase, or development-only demo fixtures.
LIVE_EARTH_DATA_MODE=public
LIVE_EARTH_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public-feed enhancements.
# Server-side proxy for public-source checks; include the local proxy port.
# Example: LIVE_EARTH_PROXY_URL=http://127.0.0.1:7890
LIVE_EARTH_PROXY_URL=
# Optional: anonymous TfL access is capped at 50 requests/min; free registration raises it to 500/min.
# https://api-portal.tfl.gov.uk/signup
TFL_API_KEY=
# Recommended by Fintraffic so they can contact high-volume API users.
DIGITRAFFIC_USER=LiveEarth/0.1 your-email@example.com
# Override these only when an operator rotates its embeddable YouTube live video ID.
LIVE_EARTH_YOUTUBE_EARTH_VIDEO_ID=fO9e9jnhYK8
LIVE_EARTH_YOUTUBE_OCEAN_VIDEO_ID=DHUnz4dyb54
LIVE_EARTH_YOUTUBE_SHARK_VIDEO_ID=YT7lH6U68S4

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=

# Stream delivery and analysis
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPEN_METEO_API_KEY=

# Worker queue
REDIS_URL=redis://localhost:6379
LIVE_EARTH_SAMPLE_INTERVAL_SECONDS=30
LIVE_EARTH_RANKING_INTERVAL_SECONDS=300
