# Uses authorised external public feeds without Supabase or paid API keys.
LIVE_EARTH_DATA_MODE=public
LIVE_EARTH_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-side proxy for public-source checks. A host:port value is
# treated as HTTP; full HTTP, HTTPS, SOCKS and SOCKS5 URLs are also accepted.
# Example: LIVE_EARTH_PROXY_URL=http://127.0.0.1:7890
LIVE_EARTH_PROXY_URL=

# Optional quota upgrade: free email registration at https://api-portal.tfl.gov.uk/signup
TFL_API_KEY=
DIGITRAFFIC_USER=LiveEarth/0.1 your-email@example.com
LIVE_EARTH_YOUTUBE_EARTH_VIDEO_ID=fO9e9jnhYK8
LIVE_EARTH_YOUTUBE_OCEAN_VIDEO_ID=DHUnz4dyb54
LIVE_EARTH_YOUTUBE_SHARK_VIDEO_ID=YT7lH6U68S4

# Required for sign-in, cloud sync, account deletion and real rankings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated operator accounts allowed into /admin.
ADMIN_EMAILS=
